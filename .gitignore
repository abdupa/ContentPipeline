# Python
/backend/venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
/frontend/node_modules/
/frontend/dist/
npm-debug.log

# Docker
.dockerignore

# IDE/OS files
.vscode/
.DS_Store
.idea/
.codex

# Environment variables
# Never commit secret keys!
.env
.env.*
!.env.example
# Browser session data
backend/browser_profile/
chrome_dev_session/
backend/google-sheets-credentials.json

# Runtime data and local logs
*.log
backend/audit_log.jsonl
backend/celerybeat-schedule*
celerybeat-schedule*

# Ignore common temporary file names
tmp/
tmp.*
tmp.js
frontend/tmp.css
frontend/tmp.html
frontend/tmp.json
backend/tmp.*
frontend/**/tmp/
frontend/**/tmp.*

# Ignore files with version numbers or specific suffixes
frontend/*[0-9].*.php
frontend/*[0-9].*.css
frontend/*xxx.php
frontend/*[0-9].*.js

# Ignore specific JSON files if they are temporary
frontend/tmp*.json
frontend/**/tmp*.json

# Ignore backup/copy files
* copy*
* Copy*
*Orig*
*Back*
*Backup*
*.bak
*.backup

# Ignore temporary php files
backend/tmp.php
backend/product_database.json

# Nested plugin/vendor repositories should not be committed into this repo
frontend/**/.git/
